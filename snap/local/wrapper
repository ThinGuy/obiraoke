#!/bin/sh
# NOTE: Do NOT add set -e to this file. Error handling is explicit.
# set -e causes silent exits on non-zero returns including intentional
# test conditions. Handle your own errors. The author knows the context,
# bash does not.

# Set up PulseAudio environment for snap confinement
if [ -f "$SNAP/bin/pulseaudio-setup" ]; then
    . "$SNAP/bin/pulseaudio-setup"
fi

export COREAOKE_CONFIG_DIR="$SNAP_USER_DATA/config"
export COREAOKE_SONGS_DIR="$SNAP_COMMON/coreaoke-songs"

# White-label branding: export app-name and app-icon from snap config
app_name="$(snapctl get app-name)" || true
if [ -n "$app_name" ]; then
    export COREAOKE_APP_NAME="$app_name"
fi

app_icon="$(snapctl get app-icon)" || true
if [ -n "$app_icon" ]; then
    export COREAOKE_APP_ICON="$app_icon"
fi

lockdown="$(snapctl get lockdown)" || true
if [ -n "$lockdown" ]; then
    export COREAOKE_LOCKDOWN="$lockdown"
fi

logo_position="$(snapctl get logo-position)" || true
if [ -n "$logo_position" ]; then
    export COREAOKE_LOGO_POSITION="$logo_position"
fi

# When running as a daemon, redirect output to a log file.
# JOURNAL_STREAM is set by systemd for service units.
if [ -n "$SNAP_INSTANCE_NAME" ] && [ -n "$JOURNAL_STREAM" ]; then
    LOG_FILE="$SNAP_COMMON/coreaoke.log"
    LOG_MAX=10485760  # 10 MB

    # Rotate the log if it exceeds the cap
    if [ -f "$LOG_FILE" ]; then
        log_size="$(stat -c '%s' "$LOG_FILE" 2>/dev/null || echo 0)"
        if [ "$log_size" -ge "$LOG_MAX" ]; then
            mv -f "$LOG_FILE" "${LOG_FILE}.1"
        fi
    fi

    exec >>"$LOG_FILE" 2>&1
fi

# Read snap configuration keys (set via: snap set coreaoke key=value)
COREAOKE_ARGS=""

port="$(snapctl get port)" || true
if [ -n "$port" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --port $port"
fi

admin_password="$(snapctl get admin-password)" || true
if [ -n "$admin_password" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --admin-password $admin_password"
fi

download_path="$(snapctl get download-path)" || true
if [ -n "$download_path" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --download-path $download_path"
else
    COREAOKE_ARGS="$COREAOKE_ARGS --download-path $SNAP_COMMON/coreaoke-songs"
fi

log_level="$(snapctl get log-level)" || true
if [ -n "$log_level" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --log-level $log_level"
fi

headless="$(snapctl get headless)" || true
if [ "$headless" = "true" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --headless"
fi

streaming_format="$(snapctl get streaming-format)" || true
if [ -n "$streaming_format" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --streaming-format $streaming_format"
fi

# Default to headless if no config was set for it
if [ -z "$headless" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --headless"
fi

proxy="$(snapctl get proxy)" || true
if [ -n "$proxy" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --youtubedl-proxy $proxy"
fi

# Boolean keys -- add flag when set to "true"
normalize_audio="$(snapctl get normalize-audio)" || true
if [ "$normalize_audio" = "true" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --normalize-audio"
fi

disable_score="$(snapctl get disable-score)" || true
if [ "$disable_score" = "true" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --disable-score"
fi

high_quality="$(snapctl get high-quality)" || true
if [ "$high_quality" = "true" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --high-quality"
fi

prefer_hostname="$(snapctl get prefer-hostname)" || true
if [ "$prefer_hostname" = "true" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --prefer-hostname"
fi

disable_bg_music="$(snapctl get disable-bg-music)" || true
if [ "$disable_bg_music" = "true" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --disable-bg-music"
fi

disable_bg_video="$(snapctl get disable-bg-video)" || true
if [ "$disable_bg_video" = "true" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --disable-bg-video"
fi

show_splash_clock="$(snapctl get show-splash-clock)" || true
if [ "$show_splash_clock" = "true" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --show-splash-clock"
fi

hide_url="$(snapctl get hide-url)" || true
if [ "$hide_url" = "true" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --hide-url"
fi

# Value keys -- pass as --key value when set
volume="$(snapctl get volume)" || true
if [ -n "$volume" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --volume $volume"
fi

bg_music_volume="$(snapctl get bg-music-volume)" || true
if [ -n "$bg_music_volume" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --bg-music-volume $bg_music_volume"
fi

splash_delay="$(snapctl get splash-delay)" || true
if [ -n "$splash_delay" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --splash-delay $splash_delay"
fi

screensaver_timeout="$(snapctl get screensaver-timeout)" || true
if [ -n "$screensaver_timeout" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --screensaver-timeout $screensaver_timeout"
fi

bg_video_path="$(snapctl get bg-video-path)" || true
if [ -n "$bg_video_path" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --bg-video-path $bg_video_path"
fi

bg_music_path="$(snapctl get bg-music-path)" || true
if [ -n "$bg_music_path" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --bg-music-path $bg_music_path"
fi

logo_path="$(snapctl get logo-path)" || true
if [ -n "$logo_path" ]; then
    COREAOKE_ARGS="$COREAOKE_ARGS --logo-path $logo_path"
fi

preseed_url="$(snapctl get preseed-url)" || true
if [ -n "$preseed_url" ]; then
    if [ ! -f "$SNAP_COMMON/.preseed-done" ]; then
        curl -fsSL "$preseed_url" -o "$SNAP_COMMON/.preseed.tar.gz"
        tar -xzf "$SNAP_COMMON/.preseed.tar.gz" -C "$SNAP_COMMON/coreaoke-songs/"
        rm -f "$SNAP_COMMON/.preseed.tar.gz"
        touch "$SNAP_COMMON/.preseed-done"
        echo "Preseed complete from $preseed_url"
    fi
fi

exec "$SNAP/bin/coreaoke" $COREAOKE_ARGS "$@"
