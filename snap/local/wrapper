#!/bin/sh
set -e

# Set up PulseAudio environment for snap confinement
if [ -f "$SNAP/bin/pulseaudio-setup" ]; then
    . "$SNAP/bin/pulseaudio-setup"
fi

export PIKARAOKE_CONFIG_DIR="$SNAP_USER_DATA/.pikaraoke"
export PIKARAOKE_SONGS_DIR="$HOME/obiraoke-songs"

# Default to headless; caller can override via OBIRAOKE_ARGS
OBIRAOKE_ARGS="${OBIRAOKE_ARGS:---headless}"

exec "$SNAP/bin/obiraoke" $OBIRAOKE_ARGS "$@"
