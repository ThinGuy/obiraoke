#!/bin/sh
# NOTE: Do NOT add set -e to this file. Error handling is explicit.
# set -e causes silent exits on non-zero returns including intentional
# test conditions. Handle your own errors. The author knows the context,
# bash does not.

# Validate snap configuration keys set via: snap set coreaoke key=value

# Validate port (must be numeric 1-65535)
port="$(snapctl get port)" || true
if [ -n "$port" ]; then
    case "$port" in
        ''|*[!0-9]*)
            echo "error: port must be a number between 1 and 65535, got '$port'" >&2
            exit 1
            ;;
    esac
    if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
        echo "error: port must be between 1 and 65535, got '$port'" >&2
        exit 1
    fi
fi

# Validate streaming-format (must be hls or mp4)
streaming_format="$(snapctl get streaming-format)" || true
if [ -n "$streaming_format" ]; then
    case "$streaming_format" in
        hls|mp4) ;;
        *)
            echo "error: streaming-format must be 'hls' or 'mp4', got '$streaming_format'" >&2
            exit 1
            ;;
    esac
fi

# Ensure the shared songs directory exists with world-writable permissions.
# This covers the case where download-path is changed via snap set and the
# default directory was not yet created (e.g. install hook did not run).
if [ ! -d "$SNAP_COMMON/coreaoke-songs" ]; then
    mkdir -p "$SNAP_COMMON/coreaoke-songs"
    chmod 0777 "$SNAP_COMMON/coreaoke-songs"
fi

# Handle autostart toggle for the daemon service
autostart="$(snapctl get autostart)" || true
if [ -n "$autostart" ]; then
    case "$autostart" in
        true)
            snapctl start --enable "$SNAP_INSTANCE_NAME.coreaoke-server"
            ;;
        false)
            snapctl stop --disable "$SNAP_INSTANCE_NAME.coreaoke-server"
            ;;
        *)
            echo "error: autostart must be 'true' or 'false', got '$autostart'" >&2
            exit 1
            ;;
    esac
fi

# Validate volume (must be a number between 0 and 1)
volume="$(snapctl get volume)" || true
if [ -n "$volume" ]; then
    case "$volume" in
        0|1|0.*|1.0|1.00)
            # Extract numeric check: reject non-numeric and out-of-range
            if ! printf '%s\n' "$volume" | grep -qE '^(0(\.[0-9]+)?|1(\.0+)?)$'; then
                echo "error: volume must be a number between 0 and 1, got '$volume'" >&2
                exit 1
            fi
            ;;
        *)
            echo "error: volume must be a number between 0 and 1, got '$volume'" >&2
            exit 1
            ;;
    esac
fi

# Validate bg-music-volume (must be a number between 0 and 1)
bg_music_volume="$(snapctl get bg-music-volume)" || true
if [ -n "$bg_music_volume" ]; then
    case "$bg_music_volume" in
        0|1|0.*|1.0|1.00)
            if ! printf '%s\n' "$bg_music_volume" | grep -qE '^(0(\.[0-9]+)?|1(\.0+)?)$'; then
                echo "error: bg-music-volume must be a number between 0 and 1, got '$bg_music_volume'" >&2
                exit 1
            fi
            ;;
        *)
            echo "error: bg-music-volume must be a number between 0 and 1, got '$bg_music_volume'" >&2
            exit 1
            ;;
    esac
fi

# Validate splash-delay (must be a non-negative integer)
splash_delay="$(snapctl get splash-delay)" || true
if [ -n "$splash_delay" ]; then
    case "$splash_delay" in
        ''|*[!0-9]*)
            echo "error: splash-delay must be a non-negative integer, got '$splash_delay'" >&2
            exit 1
            ;;
    esac
fi

# Validate screensaver-timeout (must be a non-negative integer)
screensaver_timeout="$(snapctl get screensaver-timeout)" || true
if [ -n "$screensaver_timeout" ]; then
    case "$screensaver_timeout" in
        ''|*[!0-9]*)
            echo "error: screensaver-timeout must be a non-negative integer, got '$screensaver_timeout'" >&2
            exit 1
            ;;
    esac
fi

# Handle theme preset -- sets logo-path, bg-video-path, and bg-music-path
# from a named theme directory under $SNAP_COMMON/themes/.
theme="$(snapctl get theme)" || true
if [ -n "$theme" ]; then
    theme_dir="$SNAP_COMMON/themes/$theme"
    if [ -d "$theme_dir" ]; then
        snapctl set logo-path="$SNAP_COMMON/themes/$theme/logo.png"
        snapctl set bg-video-path="$SNAP_COMMON/themes/$theme/bg-video.mp4"
        snapctl set bg-music-path="$SNAP_COMMON/themes/$theme/bg-music"
    else
        echo "error: theme directory '$theme_dir' does not exist" >&2
        exit 1
    fi
fi

# The following keys are accepted without validation:
# admin-password       -- any string
# download-path        -- any path string
# log-level            -- passed through to the application
# headless             -- boolean (true/false)
# proxy                -- HTTP proxy URL for yt-dlp
# normalize-audio      -- boolean (true/false)
# disable-score        -- boolean (true/false)
# high-quality         -- boolean (true/false)
# prefer-hostname      -- boolean (true/false)
# disable-bg-music     -- boolean (true/false)
# disable-bg-video     -- boolean (true/false)
# show-splash-clock    -- boolean (true/false)
# hide-url             -- boolean (true/false)
# bg-video-path        -- any path string
# bg-music-path        -- any path string
# logo-path            -- any path string
# theme                -- named theme preset (sets logo/video/music paths)
# preseed-url          -- URL to a song tarball for first-run preseed
