#!/bin/sh
# NOTE: Do NOT add set -e to this file. Error handling is explicit.
# set -e causes silent exits on non-zero returns including intentional
# test conditions. Handle your own errors. The author knows the context,
# bash does not.

# Create the shared songs directory so non-root users can download to it.
# $SNAP_COMMON is /var/snap/coreaoke/common, owned by root. Subdirectories
# must be created here (running as root) with world-writable permissions.
mkdir -p "$SNAP_COMMON/coreaoke-songs"
chmod 0777 "$SNAP_COMMON/coreaoke-songs"

# Create the logs directory and seed the log file for the daemon.
mkdir -p "$SNAP_COMMON/logs"
chmod 0755 "$SNAP_COMMON/logs"
touch "$SNAP_COMMON/coreaoke.log"
chmod 0644 "$SNAP_COMMON/coreaoke.log"

# Create the default theme directory and copy built-in assets into it.
# Themes live under $SNAP_COMMON/themes/<name>/ and bundle logo, background
# video, and background music into a single switchable preset.
mkdir -p "$SNAP_COMMON/themes/default/bg-music"
chmod 0755 "$SNAP_COMMON/themes/default"
chmod 0755 "$SNAP_COMMON/themes/default/bg-music"

cp "$SNAP/lib/python3.12/site-packages/coreaoke/static/images/logo.png" "$SNAP_COMMON/themes/default/logo.png"
cp "$SNAP/lib/python3.12/site-packages/coreaoke/static/video/the_drive_by_visualdon.mp4" "$SNAP_COMMON/themes/default/bg-video.mp4"
cp "$SNAP/lib/python3.12/site-packages/coreaoke/static/music/"* "$SNAP_COMMON/themes/default/bg-music/" 2>/dev/null || true

chmod 0644 "$SNAP_COMMON/themes/default/logo.png"
chmod 0644 "$SNAP_COMMON/themes/default/bg-video.mp4"
find "$SNAP_COMMON/themes/default/bg-music" -type f -exec chmod 0644 {} +

# Create the signage directory for digital signage channels.
# Each subdirectory under signage/ with a channel.yaml is a channel.
mkdir -p "$SNAP_COMMON/signage"
chmod 0777 "$SNAP_COMMON/signage"

# Seed default channel configs if not already present.
if [ -d "$SNAP/signage" ]; then
  for channel_dir in "$SNAP/signage"/*/; do
    channel_name="$(basename "$channel_dir")"
    target="$SNAP_COMMON/signage/$channel_name"
    mkdir -p "$target"
    chmod 0777 "$target"
    if [ ! -f "$target/channel.yaml" ] && [ -f "$channel_dir/channel.yaml" ]; then
      cp "$channel_dir/channel.yaml" "$target/channel.yaml"
      chmod 0644 "$target/channel.yaml"
    fi
  done
fi

# Pre-populate snap configuration keys with default values so they are
# immediately queryable after install. Keys with no sensible default
# (admin-password, proxy, download-path) are left unset until the user
# configures them.
snapctl set port=5555
snapctl set volume=0.85
snapctl set bg-music-volume=0.3
snapctl set splash-delay=2
snapctl set screensaver-timeout=300
snapctl set headless=true
snapctl set autostart=false
snapctl set streaming-format=hls
snapctl set normalize-audio=false
snapctl set disable-score=false
snapctl set high-quality=false
snapctl set prefer-hostname=false
snapctl set disable-bg-music=false
snapctl set disable-bg-video=false
snapctl set show-splash-clock=false
snapctl set hide-url=false
snapctl set theme=default
snapctl set preseed-url=""
snapctl set app-name="Ubuntu Coreaoke"
snapctl set app-icon=""
