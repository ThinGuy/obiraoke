#!/bin/sh
set -e

# Create the shared songs directory so non-root users can download to it.
# $SNAP_COMMON is /var/snap/coraoke/common, owned by root. Subdirectories
# must be created here (running as root) with world-writable permissions.
mkdir -p "$SNAP_COMMON/coraoke-songs"
chmod 0777 "$SNAP_COMMON/coraoke-songs"

# Create the logs directory and seed the log file for the daemon.
mkdir -p "$SNAP_COMMON/logs"
chmod 0755 "$SNAP_COMMON/logs"
touch "$SNAP_COMMON/coraoke.log"
chmod 0644 "$SNAP_COMMON/coraoke.log"

# Pre-populate snap configuration keys with default values so they are
# immediately queryable after install. Keys with no sensible default
# (admin-password, proxy, bg-video-path, bg-music-path, logo-path,
# download-path) are left unset until the user configures them.
snapctl set port=5555
snapctl set volume=0.85
snapctl set bg-music-volume=0.3
snapctl set splash-delay=2
snapctl set screensaver-timeout=300
snapctl set headless=true
snapctl set autostart=false
snapctl set streaming-format=hls
snapctl set normalize-audio=false
snapctl set disable-score=false
snapctl set high-quality=false
snapctl set prefer-hostname=false
snapctl set disable-bg-music=false
snapctl set disable-bg-video=false
snapctl set show-splash-clock=false
snapctl set hide-url=false
